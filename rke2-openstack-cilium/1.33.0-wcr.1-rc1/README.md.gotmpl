  customValues: {}

logging:
  enabled: true  # Enabled by default in this template
  clusterOutputs:
    server:
      host: "<changeme>"
      port: 24224
  # Default values (applied when customValues is empty):
  # rke2:
  #   enabled: true
  # logging:
  #   enableRecreateWorkloadOnImmutableFieldChange: true
  #   enabled: true
  #   clusterFlows:
