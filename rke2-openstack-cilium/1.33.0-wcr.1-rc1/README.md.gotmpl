# Virtualization Add-ons (enabled by default in this template)
kubevirt:
  enabled: true  # Enabled by default in this template
  # Default values (applied when customValues is empty):
  # kubevirt:
  #   configuration:
  #     developerConfiguration:
  #       useEmulation: true
  customValues: {}

# CNI Configuration (Cilium-specific)
cniConfig:
  podCIDR: "10.42.0.0/16"
  serviceCIDR: "10.42.0.0/16"  # Note: same as podCIDR in template
  mtu: 1440
  tunnelProtocol: "VXLAN"
  masquerade: true
  bgp: false
  multusEnabled: false
  # Default values (applied when customValues is empty): None (uses Cilium chart defaults)
